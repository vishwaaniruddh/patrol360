# backend/.htaccess
# Routes root backend requests to public folder automatically

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. If the requested file or folder actually exists in backend/, serve it directly!
    # (e.g. api_documentation.html, README.md, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. If the request is already pointing to public/, leave it alone
    RewriteCond %{REQUEST_URI} !^/patrol360/backend/public/
    RewriteCond %{REQUEST_URI} !^/vehicle_gov/backend/public/
    RewriteCond %{REQUEST_URI} !public/

    # 3. Forward all other API requests to public/
    RewriteRule ^$ public/ [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
