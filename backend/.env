# Patrol360 Backend Environment Configuration

# Central Government Webhook Credentials (api-patrol.urosgeotechlab.com)
PATROL_GOV_WEBHOOK_URL=https://api-patrol.urosgeotechlab.com/api/webhooks/receiver
PATROL_GOV_API_KEY=YOUR_API_KEY
PATROL_GOV_API_SECRET=YOUR_API_SECRET

# Optional override: Leave commented out so the system automatically detects
# localhost vs sarsspl.com production from the HTTP Host header.
# APP_ENV=production
