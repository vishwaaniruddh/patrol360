{
  "name": "patrol360/backend",
  "description": "Patrol360 Police Vehicle AI Intelligence System REST API Backend",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "firebase/php-jwt": "*",
    "phpmailer/phpmailer": "^6.9",
    "phpoffice/phpspreadsheet": "^2.3",
    "dompdf/dompdf": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {},
    "policy": {
      "advisories": {
        "block": false
      }
    }
  }
}
